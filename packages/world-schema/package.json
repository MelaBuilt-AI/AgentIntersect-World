{
  "name": "@agentintersect-world/world-schema",
  "version": "0.14.0-phase14",
  "private": true,
  "type": "module",
  "exports": {
    "./environment-assets": {
      "types": "./dist/environment-assets.d.ts",
      "import": "./dist/environment-assets.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js"
    },
    "./agent-setup": {
      "types": "./dist/agent-setup.d.ts",
      "import": "./dist/agent-setup.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
